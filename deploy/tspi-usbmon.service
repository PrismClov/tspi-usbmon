[Unit]
Description=Taishan Pi USB secondary display (udisp gadget)
After=systemd-modules-load.service local-fs.target
Wants=dev-dri-card0.device
StartLimitIntervalSec=60
StartLimitBurst=5
# 面板被 USB 副屏独占，图形桌面若在运行会抢 DRM master，
# 需要时请手动：systemctl disable --now gdm3
Conflicts=display-manager.service

[Service]
Type=simple
ExecStartPre=-modprobe usb_f_fs
ExecStart=/usr/local/bin/tspi-usbmon --config /etc/tspi-usbmon.conf
Restart=on-failure
RestartSec=5
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
