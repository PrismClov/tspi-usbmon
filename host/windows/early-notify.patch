+int enc_grab_surface(std::shared_ptr<Direct3DDevice> device, ComPtr<IDXGIResource> resource,
+                     uint8_t *pixels, D3D11_TEXTURE2D_DESC *desc, IDDCX_SWAPCHAIN chain, bool& notified, HRESULT& notifyStatus) {
+    ComPtr<ID3D11Texture2D> source;
+    HRESULT hr = resource.As(&source);
+    if (FAILED(hr)) return hr;
+    source->GetDesc(desc);
+    if (desc->Width > DISP_MAX_WIDTH || desc->Height > DISP_MAX_HEIGHT ||
+        desc->SampleDesc.Count != 1 || desc->MipLevels != 1 || desc->ArraySize != 1)
+        return E_INVALIDARG;
+    auto &staging = device->Readback;
+    D3D11_TEXTURE2D_DESC cached = {};
+    if (staging) staging->GetDesc(&cached);
+    if (!staging || cached.Width != desc->Width || cached.Height != desc->Height ||
+        cached.Format != desc->Format) {
+        auto spec = *desc;
+        spec.Usage = D3D11_USAGE_STAGING;
+        spec.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        spec.BindFlags = spec.MiscFlags = 0;
+        hr = device->Device->CreateTexture2D(&spec, nullptr, staging.ReleaseAndGetAddressOf());
+        if (FAILED(hr)) return hr;
+    }
+    device->DeviceContext->CopyResource(staging.Get(), source.Get());
+    // The desktop surface is no longer needed once its GPU copy is submitted.
+    device->DeviceContext->Flush();
+    notified = true;
+    notifyStatus = IddCxSwapChainFinishedProcessingFrame(chain);
+    if (FAILED(notifyStatus)) return notifyStatus;
+    D3D11_MAPPED_SUBRESOURCE map = {};
+    hr = device->DeviceContext->Map(staging.Get(), 0, D3D11_MAP_READ, 0, &map);
+    if (FAILED(hr)) return hr;
+    const size_t row = size_t(desc->Width) * 4;
+    if (map.RowPitch == row) memcpy(pixels, map.pData, row * desc->Height);
+    else for (UINT y = 0; y < desc->Height; ++y)
+        memcpy(pixels + y * row, static_cast<const BYTE *>(map.pData) + size_t(y)*map.RowPitch, row);
+    device->DeviceContext->Unmap(staging.Get(), 0);
+    return S_OK;
+}
