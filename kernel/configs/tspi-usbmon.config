# ---------------------------------------------------------------------------
# tspi-usbmon kernel config fragment
#
# 用法（泰山派 SDK / Rockchip rk4.1 构建系统）：
#   1) 把本文件复制到 kernel/arch/arm64/configs/tspi-usbmon.config
#   2) 在 device/rockchip/.chips/rk3566_rk3568/tspi-rk3566-ubuntu*_defconfig 里
#      把 tspi-usbmon.config 追加到 RK_KERNEL_CFG_FRAGMENTS
#   scripts/kernel-integrate.sh 会自动完成以上两步。
# ---------------------------------------------------------------------------

# --- USB device / FunctionFS (udisp gadget) ---
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_STORAGE_NUM_BUFFERS=2
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_F_FS=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_XHCI_HCD=y

# --- DRM / MIPI-DSI panel ---
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y

# --- input: Samsung sec_ts (TL060FVXS07/08 incell touch) ---
CONFIG_INPUT_EVDEV=y
CONFIG_TOUCHSCREEN_SEC_TS_1223=y

# --- 2 x 1080x2160 XRGB8888 dumb buffers need contiguous memory ---
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_DMA_CMA=y
